#!/usr/bin/env bash
# Optional local check. Enable once per clone:
#   git config core.hooksPath .ai-review
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
PY=""
for c in python3 python py; do
  command -v "$c" >/dev/null 2>&1 && "$c" -c "import sys" >/dev/null 2>&1 && { PY="$c"; break; }
done
[ -z "$PY" ] && { echo "pre-commit: no Python found; skipping."; exit 0; }
REVIEW_PLATFORM=none REVIEW_MODE=heuristic "$PY" "$ROOT/.ai-review/ai-pr-review.pyz" || {
  echo ""; echo "Pre-commit check flagged issues. Fix, or bypass with: git commit --no-verify"; exit 1
}
